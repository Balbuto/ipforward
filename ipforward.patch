+usage() {
+    cat <<USAGE_EOF
+IPTABLES FORWARDING MANAGER v${SCRIPT_VERSION}
+
+Использование:
+  sudo ipforward                 интерактивное меню (по умолчанию)
+  sudo ipforward list [--raw]    показать активные DNAT-правила
+  sudo ipforward diag            диагностика окружения (без изменений)
+  ipforward --help               эта справка
+  ipforward --version            версия
+
+Требования: Linux, Bash 4.3+, root (для пунктов, изменяющих систему).
+
+Документация: ${REPO_URL}
+USAGE_EOF
+}
+
+print_version() {
+    echo "ipforward ${SCRIPT_VERSION}"
+}
+
+# --- CLI: list -----------------------------------------------------------
+cli_list() {
+    local _raw=0
+    [[ "${1:-}" == "--raw" ]] && _raw=1
+
+    local -a _rules_list=()
+    local -a _raw_list=()
+    parse_nat_rules _rules_list _raw_list || true
+
+    if [[ ${#_rules_list[@]} -eq 0 ]]; then
+        echo "Нет DNAT-правил"
+        return 0
+    fi
+
+    if [[ $_raw -eq 1 ]]; then
+        local _k
+        for _k in "${!_raw_list[@]}"; do
+            echo "${_raw_list[$_k]}"
+        done
+        return 0
+    fi
+
+    printf "%-4s | %-8s | %-11s | %s\n" "N" "Протокол" "Порт" "Назначение"
+    echo "---------------------------------------------------------------"
+    local _i=1 _rule _p _port _dest
+    for _rule in "${_rules_list[@]}"; do
+        IFS='|' read -r _p _port _dest <<< "$_rule"
+        printf "%-4s | %-8s | %-11s | %s\n" "$_i" "$_p" "$_port" "$_dest"
+        (( _i++ )) || true
     done
+    return 0
+}
+
+# --- CLI: diag -----------------------------------------------------------
+cli_diag() {
+    local _rc=0
+    _diag_line() {
+        local _status="$1" _name="$2" _value="$3" _pad
+        # FIX #23: printf "%-28s" считает БАЙТЫ в C-locale, поэтому на кириллице
+        # колонки разъезжались. Добиваем пробелы вручную — ${#_name} и padding
+        # измеряются одинаково в любом locale.
+        _pad=$((28 - ${#_name}))
+        (( _pad < 1 )) && _pad=1
+        printf "[%-6s] %s%*s%s\n" "$_status" "$_name" "$_pad" "" "$_value"
+    }
+
+    echo "ipforward ${SCRIPT_VERSION} — диагностика"
+    echo "---------------------------------------------------------------"
+
+    # ОС
+    if [[ -r /etc/os-release ]]; then
+        # shellcheck source=/dev/null
+        _diag_line "OK" "Дистрибутив" "$( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$NAME}" )"
+    else
+        _diag_line "WARN" "Дистрибутив" "не определён"
+    fi
+
+    # ядро
+    _diag_line "INFO" "Ядро" "$(uname -r)"
+    # bash
+    if [[ "${BASH_VERSINFO[0]}" -gt 4 ]] || [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 3 ]]; then
+        _diag_line "OK" "Bash >= 4.3" "$BASH_VERSION"
+    else
+        _diag_line "FAIL" "Bash >= 4.3" "$BASH_VERSION"
+        _rc=1
+    fi
+
+    # root
+    if [[ "$EUID" -eq 0 ]]; then
+        _diag_line "OK" "Root" "да"
+    else
+        _diag_line "WARN" "Root" "нет (менять правила нельзя)"
+    fi
+
+    # зависимости
+    local _cmd
+    for _cmd in iptables iptables-save ip ss nc timeout; do
+        if command -v "$_cmd" &>/dev/null; then
+            _diag_line "OK" "Зависимость: $_cmd" "$(command -v "$_cmd")"
+        else
+            _diag_line "FAIL" "Зависимость: $_cmd" "не найдена"
+            _rc=1
+        fi
+    done
+
+    # ip_forward
+    local _fwd
+    _fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo "?")
+    if [[ "$_fwd" == "1" ]]; then
+        _diag_line "OK" "net.ipv4.ip_forward" "1"
+    else
+        _diag_line "WARN" "net.ipv4.ip_forward" "${_fwd} (скрипт включит при старте)"
+    fi
+
+    # bbr
+    local _cc
+    _cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "?")
+    _diag_line "INFO" "TCP congestion control" "$_cc"
+
+    # интерфейс
+    local _iface
+    if _iface=$(get_default_interface 2>/dev/null); then
+        _diag_line "OK" "Интерфейс по умолчанию" "$_iface"
+    else
+        _diag_line "FAIL" "Интерфейс по умолчанию" "не определён"
+        _rc=1
+    fi
+
+    # контейнер
+    if is_container; then
+        _diag_line "INFO" "Контейнер" "да (BBR пропускается)"
+    else
+        _diag_line "INFO" "Контейнер" "нет"
+    fi
+
+    # persistence
+    if command -v netfilter-persistent &>/dev/null; then
+        _diag_line "OK" "netfilter-persistent" "есть"
+    else
+        _diag_line "WARN" "netfilter-persistent" "нет (fallback: iptables-save)"
+    fi
+    if [[ -f /etc/iptables/rules.v4 ]]; then
+        _diag_line "OK" "/etc/iptables/rules.v4" "$(stat -c '%y' /etc/iptables/rules.v4 2>/dev/null | cut -d. -f1)"
+    else
+        _diag_line "INFO" "/etc/iptables/rules.v4" "нет (создастся при сохранении)"
+    fi
+
+    # ufw
+    if command -v ufw &>/dev/null; then
+        local _ufw
+        _ufw=$(ufw status 2>/dev/null | head -1)
+        _diag_line "INFO" "UFW" "${_ufw:-неизвестно}"
+    else
+        _diag_line "INFO" "UFW" "не установлен"
+    fi
+
+    # правила
+    local -a _rules=()
+    local -a _raw=()
+    parse_nat_rules _rules _raw || true
+    _diag_line "INFO" "DNAT-правил в nat" "${#_rules[@]}"
+
+    # lock
+    if [[ -f "$LOCK_FILE" ]]; then
+        _diag_line "WARN" "Lock-файл" "$LOCK_FILE существует (проверьте, не запущен ли процесс)"
+    else
+        _diag_line "OK" "Lock-файл" "свободен"
+    fi
+
+    echo "---------------------------------------------------------------"
+    if [[ $_rc -eq 0 ]]; then
+        echo "Итог: критичных проблем не найдено"
+    else
+        echo "Итог: есть проблемы (см. FAIL выше)"
+    fi
+    return $_rc
 }
 
