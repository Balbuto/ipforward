+    # входящий порт с другой целью; трафик уходил по первому совпадению.
+    # Возвращает цель конфликтующего правила (или пусто), только для того же протокола.
+    local _proto="$1"
+    local _port="$2"
+    local _target="$3"
+    local _line _c_proto _c_dport _c_dest
+
+    while IFS= read -r _line; do
+        [[ "$_line" != *"DNAT"* ]] && continue
+        if [[ "$_line" =~ -p[[:space:]]+([^[:space:]]+).*--dport[[:space:]]+([0-9]+(:[0-9]+)?)[[:space:]]+.*--to-destination[[:space:]]+([0-9.]+(:[0-9]+)?) ]]; then
+            _c_proto="${BASH_REMATCH[1]}"
+            _c_dport="${BASH_REMATCH[2]}"
+            _c_dest="${BASH_REMATCH[4]}"
+            [[ "$_c_dest" != *":"* ]] && _c_dest="${_c_dest}:${_c_dport%%:*}"
+            if [[ "$_c_proto" == "$_proto" && "$_c_dport" == "$_port" && "$_c_dest" != "$_target" ]]; then
+                echo "$_c_dest"
+                return 0
+            fi
+        fi
+    done < <(iptables-save -t nat 2>/dev/null)
+    return 1
+}
